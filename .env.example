NODE_ENV=development
PORT=5000
APP_NAME=Vyntra

# Comma-separated allowed origins (leave empty to allow all)
CORS_ORIGIN=
# Number of reverse proxies in front of the app (1 on Render/Heroku, 0 locally)
TRUST_PROXY=0

# JWT (required) - use a long random string
SECRET_KEY=
ACCESS_TOKEN_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=7d

# Database (DB_NAME and DB_USER are required)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=quick_serve

# Nodemailer (Gmail app password)
EMAIL_USER=
EMAIL_PASSWORD=

# Brevo (optional)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email

# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
